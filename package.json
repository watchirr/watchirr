{
  "name": "watchirr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001 --hostname 0.0.0.0",
    "dev:docker": "next dev --port 3001 --hostname 0.0.0.0 --webpack",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "build": "next build",
    "start": "next start --port 3001",
    "check": "node --test --experimental-strip-types lib/auth.check.ts lib/locale.check.ts"
  },
  "dependencies": {
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
